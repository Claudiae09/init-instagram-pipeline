# ===== Instagram API (with Instagram Login) credentials =====
# Copy this file to ".env" and fill in your values. Never commit the real .env.

# (1) Instagram User access token from the app's
#     "API setup with Instagram login" -> Generate access tokens.
IG_ACCESS_TOKEN=

# (2) Instagram app secret (shown on that same setup page). Used to make the
#     token long-lived (~60 days).
IG_APP_SECRET=

# Graph API version. Bump if Meta deprecates this one.
GRAPH_API_VERSION=v23.0
